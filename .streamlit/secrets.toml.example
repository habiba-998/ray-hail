# TEMPLATE ONLY – contains no real values. Never commit the real file.
#
# Local use:   copy to .streamlit/secrets.toml (git-ignored) and set EE_PROJECT; run `earthengine authenticate` once.
# Deployment:  paste the same structure into Streamlit Community Cloud → App settings → Secrets.

EE_PROJECT = "your-earth-engine-cloud-project-id"

# Deployment only: the fields of the service-account JSON key downloaded from Google Cloud
# (IAM & Admin → Service Accounts → Keys → Add key → JSON). Copy each field from that file.
# Keep private_key on one line inside double quotes, with the "\n" sequences exactly as in the JSON file.
[ee_service_account]
type = "service_account"
project_id = "<from key file>"
private_key_id = "<from key file>"
private_key = "<from key file>"
client_email = "<from key file>"
client_id = "<from key file>"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "<from key file>"
universe_domain = "googleapis.com"
